DATABASE_URL=postgresql://tajwid:replace-with-strong-db-password@localhost:5434/mengaji
DATABASE_SSL=false
DATABASE_POOL_MAX=10
# Generate dengan: npx auth secret  (atau openssl rand -base64 32)
AUTH_SECRET=replace-with-at-least-32-random-characters
NEXTAUTH_SECRET=replace-with-the-same-auth-secret
NEXTAUTH_URL=https://tajwidku.teknik.unismuh.ac.id
AUTH_TRUST_HOST=true
CAMPUS_GRAPHQL_URL=https://sicekcok.if.unismuh.ac.id/graphql
# Generate terpisah dengan: openssl rand -base64 48
CERTIFICATE_API_KEY=replace-with-a-separate-random-integration-key
PAYMENT_PROOF_DIR=.data/payment-proofs

# ----- Docker Compose (opsional, dipakai oleh docker-compose.yml) -----
POSTGRES_USER=tajwid
POSTGRES_PASSWORD=replace-with-strong-db-password
POSTGRES_DB=mengaji
POSTGRES_PORT=5434
APP_PORT=3015

# ----- Seed admin (npm run db:seed:admin) -----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-strong-admin-password
ADMIN_NAME=Administrator Sistem
ADMIN_EMAIL=admin@tajwid.local
